+	if err != nil {
+		t.Fatalf("websocket dial failed: %v", err)
+	}
+	defer conn.Close(websocket.StatusNormalClosure, "")
+
+	for i := 0; i < 205; i++ {
+		var event map[string]any
+		if err := wsjson.Read(ctx, conn, &event); err != nil {
+			t.Fatalf("read catch-up event %d failed: %v", i, err)
